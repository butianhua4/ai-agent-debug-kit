+                        items={sortedRewards}
@@
 }
+
+function sortRewards(rewards: IssueListDTO[], sort: RewardFilters["sort"]) {
+    const direction = sort.direction === "asc" ? 1 : -1;
+
+    return [...rewards].sort((first, second) => {
+        if (sort.field === "createdAt") {
+            return (first.createdAt - second.createdAt) * direction;
+        }
+
+        return (getPriceInUSD_CENT(first.pendingPrice) - getPriceInUSD_CENT(second.pendingPrice)) * direction;
+    });
+}
