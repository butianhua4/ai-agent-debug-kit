diff --git a/apps/js-sdk/firecrawl/src/__tests__/unit/v2/search.unit.test.ts b/apps/js-sdk/firecrawl/src/__tests__/unit/v2/search.unit.test.ts
new file mode 100644
index 0000000..1f578b6
--- /dev/null
+++ b/apps/js-sdk/firecrawl/src/__tests__/unit/v2/search.unit.test.ts
@@ -0,0 +1,36 @@
+import { jest } from "@jest/globals";
+import { FirecrawlClient } from "../../../v2/client";
+
+describe("v2.search unit", () => {
+  test("forwards documented country and enterprise search fields", async () => {
+    const client = new FirecrawlClient({ apiUrl: "http://localhost:3000" });
+    const post = jest.fn(async () => ({
+      status: 200,
+      data: {
+        success: true,
+        data: {
+          web: [],
+        },
+      },
+    }));
+
+    (client as any).http = { post };
+
+    await client.search("restaurants", {
+      country: "DE",
+      enterprise: ["zdr"],
+      limit: 5,
+    });
+
+    expect(post).toHaveBeenCalledWith(
+      "/v2/search",
+      expect.objectContaining({
+        query: "restaurants",
+        country: "DE",
+        enterprise: ["zdr"],
+        limit: 5,
+      }),
+      {},
+    );
+  });
+});
